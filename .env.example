# Скопируйте в .env.local для разработки, а на проде задайте те же переменные
# в настройках Vercel (Settings → Environment Variables).
# Подробные шаги — в DEPLOY.md.

# --- Адрес сайта -------------------------------------------------------------
# Обязателен на проде: из него собираются canonical, Open Graph и sitemap.xml.
# Значение подставляется при сборке — после изменения нужен передеплой.
NEXT_PUBLIC_SITE_URL=https://example.ru

# --- Яндекс.Метрика ----------------------------------------------------------
# Номер счётчика. Пусто — счётчик не подключается вовсе.
# Тоже подставляется при сборке: после изменения нужен передеплой.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Почта (Gmail) -----------------------------------------------------------
# SMTP_USER — тот же ящик, из которого шлём. SMTP_PASSWORD — пароль приложения
# (16 символов), обычный пароль от аккаунта Gmail не подойдёт.
# LEAD_EMAIL_FROM должен совпадать с SMTP_USER: Gmail всё равно перепишет
# отправителя на аутентифицированный ящик.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=
LEAD_EMAIL_FROM=your-account@gmail.com
# Куда падают заявки — может быть любым адресом.
LEAD_EMAIL_TO=468070@mail.ru

# --- Google Таблица (необязательно) ------------------------------------------
# Если не заполнять — заявки всё равно уходят письмом.
# ID берётся из ссылки на таблицу: /spreadsheets/d/<ЭТО_ID>/edit
GOOGLE_SHEETS_ID=1UbfXodvE8yA0eS2w5w5CLJBim95PtZ7pFfbYVgijD5g
# client_email из JSON-ключа сервисного аккаунта
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key из того же JSON — целиком, вместе с \n внутри строки
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Необязательно. По умолчанию строка пишется на первую вкладку в колонки A–E:
# время, имя, почта, телефон, источник. Указывайте имя листа, только если
# вкладок несколько и нужна конкретная: GOOGLE_SHEETS_RANGE=Заявки!A:E
GOOGLE_SHEETS_RANGE=
