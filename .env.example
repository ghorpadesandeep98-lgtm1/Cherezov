# Приём заявок с формы. Скопируйте в .env.local для локального запуска,
# на Vercel заведите те же переменные в Project → Settings → Environment Variables.
# Каналы независимы: можно включить только почту, только таблицу или оба сразу.

# ------------------------------------------------------------------ почта
# Любой SMTP: Яндекс 360 (smtp.yandex.ru:465), Mail.ru (smtp.mail.ru:465),
# Gmail с паролем приложения (smtp.gmail.com:465).
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
# true для порта 465, false для 587. Если не задать — выводится из порта.
SMTP_SECURE=true
SMTP_USER=468070@mail.ru
# Пароль приложения, а не пароль от ящика.
SMTP_PASSWORD=
# Куда падают заявки. Несколько адресов — через запятую.
LEAD_EMAIL_TO=468070@mail.ru
# Отправитель. Должен совпадать с ящиком SMTP_USER, иначе письмо не уйдёт.
LEAD_EMAIL_FROM=468070@mail.ru

# --------------------------------------------------------- google таблица
# 1. console.cloud.google.com → создать проект → включить Google Sheets API
# 2. Создать сервисный аккаунт, скачать JSON-ключ
# 3. Открыть таблицу и дать доступ «Редактор» на почту сервисного аккаунта
# ID берётся из адреса таблицы: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Значение поля private_key из JSON-ключа целиком, вместе с BEGIN/END и \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Лист и колонки для дозаписи. Лист с таким именем должен существовать.
GOOGLE_SHEETS_RANGE=Заявки!A:E
