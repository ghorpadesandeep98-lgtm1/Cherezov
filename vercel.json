{
  "framework": null,
  "buildCommand": "echo static-site",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/preview/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ],
  "redirects": [
    { "source": "/home.dc", "destination": "/", "permanent": false },
    { "source": "/home-v1-archive.dc", "destination": "/", "permanent": false },
    { "source": "/calculator.dc", "destination": "/calculator", "permanent": false },
    { "source": "/mim.dc", "destination": "/mim", "permanent": false },
    { "source": "/priroda.dc", "destination": "/priroda", "permanent": false },
    { "source": "/legal.dc", "destination": "/legal", "permanent": false }
  ]
}
